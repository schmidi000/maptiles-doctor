{
  "version": 8,
  "name": "PMTiles fixture style",
  "sprite": "../simple-style/sprite",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles://../generated/basemap.pmtiles"
    }
  },
  "layers": [
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 12,
      "maxzoom": 14,
      "paint": {
        "fill-color": ["case", [">", ["get", "height"], 20], "#888888", "#cccccc"]
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "poi",
      "maxzoom": 14,
      "layout": {
        "text-field": ["get", "name"],
        "icon-image": "marker"
      }
    }
  ]
}
