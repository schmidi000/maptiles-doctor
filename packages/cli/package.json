{
  "name": "maptiles-doctor",
  "version": "0.1.0",
  "description": "CLI for validating MapLibre/Mapbox style-to-tile contracts.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "maptiles-doctor": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
