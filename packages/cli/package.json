      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run packages/cli/test"
  },
  "dependencies": {
    "@maptiles-doctor/core": "0.1.0",
    "@maptiles-doctor/report": "0.1.0",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "zod": "4.4.3"
  }
}
