{
  "name": "maptiles-doctor",
  "version": "0.1.1",
  "description": "CLI that validates a MapLibre/Mapbox style against the PMTiles, MBTiles, TileJSON, sprite, glyph and vector-tile artifacts it ships against.",
  "keywords": [
    "maplibre",
    "mapbox",
    "map-style",
    "vector-tiles",
    "pmtiles",
    "mbtiles",
    "tilejson",
    "sprite",
    "glyphs",
    "linter",
    "validator",
    "sarif",
    "cli"
  ],
  "homepage": "https://maptiles-doctor.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmidi000/maptiles-doctor.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/schmidi000/maptiles-doctor/issues"
  },
  "author": "schmidi000",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "maptiles-doctor": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run packages/cli/test"
  },
  "dependencies": {
    "@maptiles-doctor/core": "0.1.1",
    "@maptiles-doctor/report": "0.1.1",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "zod": "4.4.3"
  }
}
