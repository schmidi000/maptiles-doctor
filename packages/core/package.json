{
  "name": "@maptiles-doctor/core",
  "version": "0.1.0",
  "description": "Contract-checking engine behind MapTiles Doctor: reads a MapLibre/Mapbox style and the tile, glyph and sprite artifacts it depends on, and reports where they disagree.",
  "keywords": [
    "maplibre",
    "mapbox",
    "map-style",
    "vector-tiles",
    "pmtiles",
    "mbtiles",
    "tilejson",
    "sprite",
    "glyphs",
    "validator"
  ],
  "homepage": "https://maptiles-doctor.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmidi000/maptiles-doctor.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/schmidi000/maptiles-doctor/issues"
  },
  "author": "schmidi000",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run packages/core/test"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "better-sqlite3": "13.0.2",
    "pbf": "5.1.2",
    "pixelmatch": "7.2.0",
    "pmtiles": "4.4.1",
    "pngjs": "7.0.0",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.0.0",
    "playwright": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
