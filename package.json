{
  "name": "maptiles-doctor-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "MapTiles Doctor verifies MapLibre/Mapbox styles against actual tile, glyph, sprite, and sampled vector-tile contracts.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit": "npm audit",
    "build": "npm run build --workspaces --if-present",
    "bundle:action": "node scripts/bundle-action.mjs",
    "bundle:action:check": "npm run bundle:action && git diff --exit-code -- packages/action/action-dist",
    "bundle:vscode": "node scripts/bundle-vscode.mjs",
    "check": "npm-run-all2 audit typecheck lint test build package:check bundle:action:check",
    "fixtures:build": "node scripts/build-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "publint packages/core && publint packages/report && publint packages/cli && publint packages/action",
    "package:vsix": "npm run bundle:vscode && npm exec --workspace maptiles-doctor-vscode -- vsce package --no-dependencies --out ../../maptiles-doctor-vscode.vsix",
    "test": "vitest run",
    "validate:real": "node validation/run.mjs",
    "validate:seed": "node validation/seed.mjs",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "git clean -fdX packages/*/dist coverage .vitest"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@mapbox/vector-tile": "3.0.0",
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "better-sqlite3": "13.0.2",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "jsonc-parser": "3.3.1",
    "maplibre-gl": "6.0.0",
    "ora": "9.4.1",
    "pbf": "5.1.2",
    "pixelmatch": "7.2.0",
    "pmtiles": "4.4.1",
    "pngjs": "7.0.0",
    "tinyglobby": "0.2.17",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "1.125.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "knip": "6.29.0",
    "npm-run-all2": "9.0.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
